# Copy to hub/.env. All optional except ANTHROPIC_API_KEY in real mode.
ANTHROPIC_API_KEY=
# 1 = scripted events, no model calls (Unity integration / demos without a key)
FAKE_AGENT=1
# Model for the Claude Agent SDK runner
AGENT_MODEL=claude-sonnet-5-5
# Reasoning effort: low | medium | high | xhigh | max (low keeps Q&A snappy)
AGENT_QA_EFFORT=low
AGENT_CODE_EFFORT=medium
# Project used when a client does not send project_id
DEFAULT_PROJECT=gatorhack
# Override the projects file location
PROJECTS_FILE=config/projects.yaml
# Also emit the existing-contract pet.say after agent.answer_done (0/1). Off by default to avoid double captions.
AGENT_EMIT_PET_SAY=0
# Speech-to-text: none | whisper  (whisper needs `pip install faster-whisper`, see requirements.txt)
STT_PROVIDER=none
WHISPER_MODEL=small
# Speech-to-speech voice (agent/voice.py): none | grok | fake
#   none: stt.py + Claude runner (above), no spoken replies
#   grok: Grok Voice session per Unity socket (needs XAI_API_KEY); transcripts -> stt.*, speech -> tts.* + binary PCM16
#   fake: canned transcript + reply spoken from agent/assets/fake_voice_24k.pcm (no key, no network)
VOICE_PROVIDER=none
XAI_API_KEY=
GROK_VOICE_MODEL=grok-voice-3.0
# Voice name from GET https://api.x.ai/v1/tts/voices (empty = xAI default "eve"). For a cartoony gator try
# sirius ("quick-witted, playful"), then cosmo / iris; a cloned custom voice id also works here.
GROK_VOICE=sirius
# Speaking speed 0.7..1.5. Unity pitches the voice up (StreamedPcmTextToSpeech.pitch, default 1.2 = cartoony),
# which also speeds it up, so keep this around 1/pitch for a natural pace (1.2 -> 0.85).
GROK_VOICE_SPEED=0.85
# Speech output rate when the client doesn't send hello.audio_out_rate (8000..48000)
GROK_VOICE_OUT_RATE=48000
# Close the Grok socket after this many idle seconds ($0.08/min while open); it reconnects on the next turn
VOICE_IDLE_CLOSE_S=120
# fake provider pacing: 1.0 = real time, 0 = instant (tests)
FAKE_VOICE_PACE=1.0
LOG_LEVEL=INFO
