# Copy to hub/.env. All optional except ANTHROPIC_API_KEY in real mode.
ANTHROPIC_API_KEY=
# 1 = scripted events, no model calls (Unity integration / demos without a key)
FAKE_AGENT=1
# Model for the Claude Agent SDK runner
AGENT_MODEL=claude-sonnet-5-5
# Reasoning effort: low | medium | high | xhigh | max (low keeps Q&A snappy)
AGENT_QA_EFFORT=low
AGENT_CODE_EFFORT=low
# Project used when a client does not send project_id
DEFAULT_PROJECT=gatorhack
# Override the projects file location
PROJECTS_FILE=config/projects.yaml
# Also emit the existing-contract pet.say after agent.answer_done (0/1). Off by default to avoid double captions.
AGENT_EMIT_PET_SAY=0
# Speech-to-text: none | whisper  (whisper needs `pip install faster-whisper`, see requirements.txt)
STT_PROVIDER=none
WHISPER_MODEL=small
# Speech-to-speech voice (agent/voice.py): none | grok | fake
#   none: stt.py + Claude runner (above), no spoken replies
#   grok: Grok Voice session per Unity socket (needs XAI_API_KEY); transcripts -> stt.*, speech -> tts.* + binary PCM16
#   fake: canned transcript + reply spoken from agent/assets/fake_voice_24k.pcm (no key, no network)
VOICE_PROVIDER=none
XAI_API_KEY=
GROK_VOICE_MODEL=grok-voice-3.0
# Voice name from GET https://api.x.ai/v1/tts/voices (empty = xAI default "eve"). For a cartoony gator try
# sirius ("quick-witted, playful"), then cosmo / iris; a cloned custom voice id also works here.
GROK_VOICE=sirius
# Speaking speed 0.7..1.5. Unity pitches the voice up (StreamedPcmTextToSpeech.pitch, default 1.2 = cartoony),
# which also speeds it up, so keep this around 1/pitch for a natural pace (1.2 -> 0.85).
GROK_VOICE_SPEED=0.85
# Speech output rate when the client doesn't send hello.audio_out_rate (8000..48000)
GROK_VOICE_OUT_RATE=48000
# Close the Grok socket after this many idle seconds ($0.08/min while open); it reconnects on the next turn
VOICE_IDLE_CLOSE_S=120
# fake provider pacing: 1.0 = real time, 0 = instant (tests)
FAKE_VOICE_PACE=1.0
# Crew (agent/crew.py): each crew code task gets its own git worktree on pet/<agent>/<task>. Default dir:
# a sibling of the repo, <repo>-crew/ (e.g. ~/Documents/gatorhack-dubz-crew). Clean up: git worktree prune
AGENT_WORKTREE_DIR=
LOG_LEVEL=INFO
# Screen bridge (hub/screens): the hub runs `npm start` in screen-bridge/ (VS Code extension install, signaling :8766,
# JPEG fallback :8765, Chrome sharing the VS Code window) and kills it on shutdown. 0 = don't; it is also skipped
# with a warning when `node` is not on PATH or the directory has no start.js.
SCREEN_BRIDGE=1
# Where start.js lives (default: ../screen-bridge next to hub/)
SCREEN_BRIDGE_DIR=
# Slack (messaging module, PROJECT_CONTEXT 8.7). Bot + app tokens empty = messaging disabled, hub still boots.
# Both written by `slack run` from hub/ (scripts/slack_cli_start.py): the app's bot identity and the Socket Mode token
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# YOUR token (xoxp-...): Bit reads your inbox and posts replies under your name. The CLI never hands it out:
# `slack app settings` > OAuth & Permissions > User OAuth Token. Empty = Bit reads only channels it was invited to
# and posts as "Bit" (one warning at startup).
SLACK_USER_TOKEN=
# Optional: your member id. Derived from SLACK_USER_TOKEN when set; only needed without it (mentions_me = <@id> in text)
SLACK_USER_ID=
# Channel id or #name drafts go to when neither the tool nor the replied-to message names one
SLACK_DEFAULT_CHANNEL=#forge-team
# Optional iMessage support (macOS only; OFF unless IMESSAGE_ENABLED=1). Grant Full Disk Access to the app running
# the hub in System Settings > Privacy & Security, then restart. Reading needs nothing else. Sending needs the imsg CLI,
# which the hub never installs: `brew install steipete/tap/imsg` (third-party tap). The first send may ask for
# Automation permission to control Messages.
# IMESSAGE_ENABLED=1
# Required privacy allowlist: only 1:1 chats with these phones/emails are read or sent to. Empty = nothing loads.
# Group chats are always hidden. Any phone format works; a bare 10-digit number is US (+1).
# IMESSAGE_ALLOW=+1 352 555 0123,friend@example.com
# IMESSAGE_DB=~/Library/Messages/chat.db
# IMESSAGE_POLL_MS=1000
# IMESSAGE_RECENT_DAYS=3
# IMESSAGE_DIGEST=false
# IMESSAGE_CLI=imsg  # optional override for a custom executable
