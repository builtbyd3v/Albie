{
  "name": "forge-bit",
  "displayName": "Forge Bit",
  "description": "Lets Bit (the Forge pet) open files, highlight code, read errors, and run training in this VS Code window.",
  "publisher": "forge",
  "version": "0.1.0",
  "license": "MIT",
  "engines": { "vscode": "^1.93.0" },
  "main": "./extension.js",
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "configuration": {
      "title": "Forge Bit",
      "properties": {
        "forgeBit.port": {
          "type": "number",
          "default": 8770,
          "description": "Local HTTP port (127.0.0.1 only)."
        },
        "forgeBit.hubUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8000",
          "description": "Forge hub. Errors in a saved file and finished \"Bit\" terminal commands are POSTed to <hubUrl>/vscode/event."
        },
        "forgeBit.trainCommand": {
          "type": "string",
          "default": "",
          "description": "Shell command that POST /train types into the \"Bit\" terminal, e.g. python train.py."
        },
        "forgeBit.allowedCommands": {
          "type": "array",
          "items": { "type": "string" },
          "default": [
            "workbench.action.togglePanel",
            "workbench.action.files.save",
            "editor.action.formatDocument",
            "workbench.actions.view.problems",
            "workbench.action.terminal.toggleTerminal",
            "workbench.action.zoomIn",
            "workbench.action.zoomOut",
            "workbench.action.zoomReset"
          ],
          "description": "VS Code command ids that POST /run may execute."
        }
      }
    }
  }
}
