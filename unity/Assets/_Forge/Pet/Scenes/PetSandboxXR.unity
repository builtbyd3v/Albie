  answerSequence:
  - type: agent.thinking
    delayMs: 0
    payloadJson: '{}'
  - type: agent.partial_answer
    delayMs: 600
    payloadJson: '{"text":"The hub lives in hub/,"}'
  - type: agent.partial_answer
    delayMs: 600
    payloadJson: '{"text":"The hub lives in hub/, a FastAPI app; the agent code is in hub/agent/"}'
  - type: agent.partial_answer
    delayMs: 600
    payloadJson: '{"text":"The hub lives in hub/, a FastAPI app; the agent code is in hub/agent/ and projects are listed in hub/config/projects.yaml."}'
  - type: agent.answer_done
    delayMs: 400
    payloadJson: '{"text":"The hub lives in hub/, a FastAPI app; the agent code is in hub/agent/ and projects are listed in hub/config/projects.yaml."}'
  taskSequence:
  - type: agent.task_started
    delayMs: 800
    payloadJson: '{"title":"{ask}"}'
  - type: agent.task_progress
    delayMs: 1000
    payloadJson: '{"text":"Reading the relevant files...","pct":25}'
  - type: agent.task_progress
    delayMs: 1000
    payloadJson: '{"text":"Editing code...","pct":60}'
  - type: agent.task_progress
    delayMs: 1000
    payloadJson: '{"text":"Running checks...","pct":90}'
  - type: agent.task_complete
    delayMs: 1000
