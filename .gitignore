# Builds
Builds/
unity/.utmp/
*.apk
*.aab
*.unitypackage
unity/sysinfo.txt
unity/crashlytics-build.properties

# Unity-generated streaming assets / addressables
unity/[Aa]ssets/[Ss]treamingAssets/aa/*
unity/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Python (hub, forge-sdk)
__pycache__/
*.py[cod]
.venv/
venv/
.env
*.egg-info/

# Node (screen-bridge)
node_modules/

# OS
.DS_Store
Thumbs.db

# Unity crash-recovery scene backups
unity/[Aa]ssets/_Recovery/
unity/[Aa]ssets/_Recovery.meta

# Unity Asset Store pack: its EULA forbids redistribution, so each machine imports it (SETUP.md step 9)
unity/Assets/_Forge/Pet/ThirdParty/Quirky Series/
unity/Assets/_Forge/Pet/ThirdParty/Quirky Series.meta
# Made from the pack's mesh, so kept out of git too (Gator_Model.fbx.meta stays: it holds the GUID and clip settings)
